<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="flugel-uml" name="UML y datos"><mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Flugel · diagrama de clases y modelo de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Estructura observada en el código de &lt;i&gt;main&lt;/i&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1480" height="75" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;El código JavaScript no declara clases. &lt;b&gt;Handler&lt;/b&gt; es la clase de aplicación del backend. Las entidades verdes representan tablas SQLite, no clases Python." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="1480" height="85" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;«módulo» · app.js&lt;/b&gt;&lt;hr&gt;Interfaz y estado del cliente&lt;br&gt;&lt;br&gt;renderDestinations() · renderTrips()&lt;br&gt;renderReports() · setAuthMode()&lt;br&gt;submitReport() · apiFetch()&lt;br&gt;loadDestinations()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff8e1;strokeColor=#d6b656;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="365" height="260" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;SimpleHTTPRequestHandler&lt;/b&gt;&lt;br&gt;&lt;i&gt;Python · biblioteca estándar&lt;/i&gt;&lt;br&gt;Sirve archivos estáticos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="610" y="155" width="365" height="115" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;ThreadingHTTPServer&lt;/b&gt;&lt;br&gt;&lt;i&gt;Python · biblioteca estándar&lt;/i&gt;&lt;br&gt;Atiende solicitudes concurrentes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1115" y="155" width="365" height="115" as="geometry"/></mxCell><mxCell id="handler" value="&lt;b&gt;«clase» · Handler&lt;/b&gt;&lt;br&gt;&lt;i&gt;server.py&lt;/i&gt;&lt;hr&gt;&lt;b&gt;Rutas HTTP&lt;/b&gt;&lt;br&gt;do_GET() · do_POST()&lt;br&gt;do_PATCH() · do_DELETE()&lt;br&gt;&lt;br&gt;&lt;b&gt;Utilidades&lt;/b&gt;&lt;br&gt;current_user(db) · report_json(row)&lt;br&gt;send_json(data, status) · body()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="610" y="330" width="470" height="335" as="geometry"/></mxCell><mxCell id="destinations" value="&lt;b&gt;«datos constantes» · DESTINATIONS&lt;/b&gt;&lt;hr&gt;Catálogo en server.py&lt;br&gt;Lectura por /api/destinations" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5eff8;strokeColor=#9673a6;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="55" y="625" width="365" height="135" as="geometry"/></mxCell><mxCell id="sqlite" value="&lt;b&gt;Persistencia · SQLite&lt;/b&gt;&lt;hr&gt;connect() abre la conexión&lt;br&gt;init_db() crea tablas y carga datos iniciales" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff1f0;strokeColor=#b85450;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="610" y="730" width="470" height="135" as="geometry"/></mxCell><mxCell id="schema-title" value="Esquema persistente · claves foráneas y cardinalidades" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="1480" height="50" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;«tabla» · users&lt;/b&gt;&lt;hr&gt;id: INTEGER PK&lt;br&gt;name, email: TEXT&lt;br&gt;salt, password_hash: TEXT&lt;br&gt;role: client | worker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f2f8f1;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="650" y="985" width="300" height="170" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;b&gt;«tabla» · sessions&lt;/b&gt;&lt;hr&gt;token: TEXT PK&lt;br&gt;user_id: INTEGER FK&lt;br&gt;created_at: TEXT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f2f8f1;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="100" y="1190" width="300" height="135" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b&gt;«tabla» · reports&lt;/b&gt;&lt;hr&gt;id: INTEGER PK · code: UNIQUE&lt;br&gt;user_id: INTEGER FK (nullable)&lt;br&gt;name, email, destination, question&lt;br&gt;status, created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f2f8f1;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="500" y="1190" width="350" height="155" as="geometry"/></mxCell><mxCell id="trips" value="&lt;b&gt;«tabla» · trips&lt;/b&gt;&lt;hr&gt;id: INTEGER PK&lt;br&gt;user_id: INTEGER FK (nullable)&lt;br&gt;city, country, dates, duration&lt;br&gt;travelers, status, image, flight" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f2f8f1;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="950" y="1190" width="350" height="155" as="geometry"/></mxCell><mxCell id="countries" value="&lt;b&gt;«tabla» · countries&lt;/b&gt;&lt;hr&gt;name: TEXT PK&lt;br&gt;flag, region, season&lt;br&gt;visa, vaccine" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f2f8f1;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1270" y="985" width="300" height="150" as="geometry"/></mxCell><mxCell id="extends" value="hereda de" style="endArrow=block;endFill=0;startArrow=none;html=1;strokeColor=#4a5568;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="handler" target="base"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="serves" value="entrega solicitudes a" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="server" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api" value="HTTP · API JSON /api/*" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="reads-destinations" value="consulta" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="handler" target="destinations"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="uses-db" value="SQL · autenticación, reportes, países y viajes" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="handler" target="sqlite"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="user-sessions" value="1 usuario · 0..* sesiones" style="endArrow=none;startArrow=none;html=1;rounded=1;strokeColor=#4a5568;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="user-reports" value="0..1 usuario · 0..* reportes" style="endArrow=none;startArrow=none;html=1;rounded=1;strokeColor=#4a5568;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="user-trips" value="0..1 usuario · 0..* viajes" style="endArrow=none;startArrow=none;html=1;rounded=1;strokeColor=#4a5568;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="trips"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>