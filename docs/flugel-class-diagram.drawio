<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="flugel-classes" name="Clases"><mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Diagrama de clases · Flugel&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#102b4e;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1450" height="70" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Alcance:&lt;/b&gt; el código de la aplicación declara una clase propia, &lt;b&gt;Handler&lt;/b&gt;. La página siguiente separa las tablas de SQLite del diagrama de clases. &lt;i&gt;app.js&lt;/i&gt; se muestra como módulo porque no declara clases." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f2f5f9;strokeColor=#aab7c4;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="55" y="115" width="1450" height="85" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;«módulo» · app.js&lt;/b&gt;&lt;hr&gt;Interfaz y estado del cliente&lt;br&gt;&lt;br&gt;renderDestinations() · renderTrips()&lt;br&gt;renderReports() · setAuthMode()&lt;br&gt;submitReport() · apiFetch()&lt;br&gt;loadDestinations()&lt;br&gt;&lt;br&gt;Consume la API JSON en &lt;b&gt;/api/*&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff8e8;strokeColor=#b88a22;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="390" height="270" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;«biblioteca estándar»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SimpleHTTPRequestHandler&lt;/b&gt;&lt;hr&gt;Entrega archivos estáticos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f8fc;strokeColor=#102b4e;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="600" y="145" width="400" height="145" as="geometry"/></mxCell><mxCell id="handler" value="&lt;b&gt;«clase» · Handler&lt;/b&gt;&lt;br&gt;&lt;i&gt;server.py&lt;/i&gt;&lt;hr&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;No declara atributos de instancia propios.&lt;hr&gt;&lt;b&gt;Operaciones&lt;/b&gt;&lt;br&gt;+ do_GET()&lt;br&gt;+ do_POST()&lt;br&gt;+ do_PATCH()&lt;br&gt;+ do_DELETE()&lt;br&gt;+ current_user(db)&lt;br&gt;+ report_json(row)&lt;br&gt;+ send_json(data, status)&lt;br&gt;+ body()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#ffffff;strokeColor=#102b4e;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="460" height="375" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;«biblioteca estándar»&lt;/b&gt;&lt;br&gt;&lt;b&gt;ThreadingHTTPServer&lt;/b&gt;&lt;hr&gt;Servidor HTTP concurrente&lt;br&gt;Recibe &lt;i&gt;Handler&lt;/i&gt; como clase de solicitud" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f8fc;strokeColor=#102b4e;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="1190" y="445" width="355" height="190" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Notación&lt;/b&gt; &amp;nbsp; ─▷ Generalización &amp;nbsp; ···▷ Dependencia&lt;br&gt;Los tipos de biblioteca estándar aparecen como contexto externo." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f2f5f9;strokeColor=#aab7c4;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="600" y="865" width="945" height="85" as="geometry"/></mxCell><mxCell id="inherit" value="" style="endArrow=block;endFill=0;startArrow=none;html=1;strokeColor=#102b4e;strokeWidth=1.7;" edge="1" parent="1" source="handler" target="base"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="api-use" value="" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#4a5568;strokeWidth=1.5;" edge="1" parent="1" source="app" target="handler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="server-use" value="" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#4a5568;strokeWidth=1.5;" edge="1" parent="1" source="server" target="handler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="flugel-data" name="Datos SQLite"><mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Datos persistentes · Flugel&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#102b4e;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1450" height="70" as="geometry"/></mxCell><mxCell id="note" value="Las cajas verdes representan &lt;b&gt;tablas SQLite&lt;/b&gt;, no clases UML. Las multiplicidades se colocan junto a cada extremo de la asociación. &lt;b&gt;PK&lt;/b&gt;: clave primaria · &lt;b&gt;FK&lt;/b&gt;: clave foránea." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f2f5f9;strokeColor=#aab7c4;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="55" y="115" width="1450" height="80" as="geometry"/></mxCell><mxCell id="destinations" value="&lt;b&gt;«constante» · DESTINATIONS&lt;/b&gt;&lt;hr&gt;Catálogo definido en &lt;i&gt;server.py&lt;/i&gt;&lt;br&gt;Se consulta mediante &lt;b&gt;/api/destinations&lt;/b&gt;&lt;br&gt;No se almacena como tabla SQLite." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff8e8;strokeColor=#b88a22;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="370" height="155" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id: INTEGER · PK&lt;br&gt;name, email: TEXT&lt;br&gt;salt, password_hash: TEXT&lt;br&gt;role: client | worker" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f1f7ef;strokeColor=#4d7c47;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="620" y="275" width="360" height="190" as="geometry"/></mxCell><mxCell id="countries" value="&lt;b&gt;countries&lt;/b&gt;&lt;hr&gt;name: TEXT · PK&lt;br&gt;flag, region, season: TEXT&lt;br&gt;visa, vaccine: TEXT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f1f7ef;strokeColor=#4d7c47;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="1160" y="285" width="350" height="155" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;b&gt;sessions&lt;/b&gt;&lt;hr&gt;token: TEXT · PK&lt;br&gt;user_id: INTEGER · FK NOT NULL&lt;br&gt;created_at: TEXT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f1f7ef;strokeColor=#4d7c47;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="360" height="155" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b&gt;reports&lt;/b&gt;&lt;hr&gt;id: INTEGER · PK&lt;br&gt;code: TEXT · UNIQUE&lt;br&gt;user_id: INTEGER · FK nullable&lt;br&gt;name, email, destination, question&lt;br&gt;status, created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f1f7ef;strokeColor=#4d7c47;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="540" y="700" width="400" height="190" as="geometry"/></mxCell><mxCell id="trips" value="&lt;b&gt;trips&lt;/b&gt;&lt;hr&gt;id: INTEGER · PK&lt;br&gt;user_id: INTEGER · FK nullable&lt;br&gt;city, country, date_from, date_to&lt;br&gt;duration, travelers, status&lt;br&gt;image, flight" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f1f7ef;strokeColor=#4d7c47;fontColor=#202b38;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="400" height="190" as="geometry"/></mxCell><mxCell id="user-sessions" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#4a5568;strokeWidth=1.5;" edge="1" parent="1" source="user" target="sessions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="user-reports" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#4a5568;strokeWidth=1.5;" edge="1" parent="1" source="user" target="reports"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="user-trips" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#4a5568;strokeWidth=1.5;" edge="1" parent="1" source="user" target="trips"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-user-sessions" value="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="570" y="490" width="45" height="28" as="geometry"/></mxCell><mxCell id="m-sessions" value="0..*" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="385" y="665" width="55" height="28" as="geometry"/></mxCell><mxCell id="m-user-reports" value="0..1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="755" y="490" width="55" height="28" as="geometry"/></mxCell><mxCell id="m-reports" value="0..*" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="755" y="665" width="55" height="28" as="geometry"/></mxCell><mxCell id="m-user-trips" value="0..1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="990" y="490" width="55" height="28" as="geometry"/></mxCell><mxCell id="m-trips" value="0..*" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="1090" y="665" width="55" height="28" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Relaciones&lt;/b&gt; &amp;nbsp; ─ Asociación &amp;nbsp;&amp;nbsp; &lt;b&gt;1&lt;/b&gt;: obligatorio y único &amp;nbsp; &lt;b&gt;0..1&lt;/b&gt;: opcional &amp;nbsp; &lt;b&gt;0..*&lt;/b&gt;: ninguno o varios" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f2f5f9;strokeColor=#aab7c4;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="80" y="945" width="1420" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>