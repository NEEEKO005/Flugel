<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="flugel-uml" name="UML class diagram"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="note" value="&lt;b&gt;Modelo basado en el código de la rama main&lt;/b&gt;&lt;br&gt;Flugel usa funciones y objetos de datos en app.js; no declara clases JavaScript. El backend declara una clase de aplicación: Handler. Las entidades persistentes están definidas como tablas SQLite." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="900" height="90" as="geometry"/></mxCell><mxCell id="app" value="«module»&lt;br&gt;&lt;b&gt;app.js&lt;/b&gt;&lt;br&gt;Estado de interfaz y datos de demostración&lt;br&gt;&lt;br&gt;+ renderDestinations()&lt;br&gt;+ renderTrips()&lt;br&gt;+ renderReports()&lt;br&gt;+ setAuthMode()&lt;br&gt;+ submitReport()&lt;br&gt;+ apiFetch() / loadDestinations()" style="" vertex="1" parent="1"><mxGeometry x="40" y="190" width="360" height="270" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;SimpleHTTPRequestHandler&lt;/b&gt;&lt;br&gt;&lt;i&gt;Python standard library&lt;/i&gt;&lt;br&gt;Entrega frontend estático" style="" vertex="1" parent="1"><mxGeometry x="510" y="35" width="340" height="105" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;ThreadingHTTPServer&lt;/b&gt;&lt;br&gt;&lt;i&gt;Python standard library&lt;/i&gt;&lt;br&gt;HTTP server concurrente" style="" vertex="1" parent="1"><mxGeometry x="1020" y="35" width="340" height="105" as="geometry"/></mxCell><mxCell id="handler" value="«class»&lt;br&gt;&lt;b&gt;Handler&lt;/b&gt;&lt;br&gt;&lt;i&gt;server.py&lt;/i&gt;&lt;hr&gt;+ do_GET()&lt;br&gt;+ do_POST()&lt;br&gt;+ do_PATCH()&lt;br&gt;+ do_DELETE()&lt;br&gt;+ current_user(db)&lt;br&gt;+ report_json(row)&lt;br&gt;+ send_json(data, status)&lt;br&gt;+ body()" style="" vertex="1" parent="1"><mxGeometry x="510" y="210" width="470" height="380" as="geometry"/></mxCell><mxCell id="user" value="«table»&lt;br&gt;&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id: INTEGER PK&lt;br&gt;name: TEXT&lt;br&gt;email: TEXT UNIQUE&lt;br&gt;salt, password_hash: TEXT&lt;br&gt;role: client | worker" style="" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="310" height="220" as="geometry"/></mxCell><mxCell id="sessions" value="«table»&lt;br&gt;&lt;b&gt;sessions&lt;/b&gt;&lt;hr&gt;token: TEXT PK&lt;br&gt;user_id: INTEGER FK → users.id&lt;br&gt;created_at: TEXT" style="" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="310" height="155" as="geometry"/></mxCell><mxCell id="reports" value="«table»&lt;br&gt;&lt;b&gt;reports&lt;/b&gt;&lt;hr&gt;id: INTEGER PK&lt;br&gt;code: TEXT UNIQUE&lt;br&gt;user_id: INTEGER FK → users.id&lt;br&gt;name, email, destination, question&lt;br&gt;status, created_at" style="" vertex="1" parent="1"><mxGeometry x="1070" y="740" width="310" height="205" as="geometry"/></mxCell><mxCell id="countries" value="«table»&lt;br&gt;&lt;b&gt;countries&lt;/b&gt;&lt;hr&gt;name: TEXT PK&lt;br&gt;flag, region, season&lt;br&gt;visa, vaccine" style="" vertex="1" parent="1"><mxGeometry x="1430" y="190" width="310" height="180" as="geometry"/></mxCell><mxCell id="trips" value="«table»&lt;br&gt;&lt;b&gt;trips&lt;/b&gt;&lt;hr&gt;id: INTEGER PK&lt;br&gt;user_id: INTEGER FK → users.id&lt;br&gt;city, country, date_from, date_to&lt;br&gt;duration, travelers, status&lt;br&gt;image, flight" style="" vertex="1" parent="1"><mxGeometry x="1430" y="500" width="310" height="220" as="geometry"/></mxCell><mxCell id="destinations" value="«constant data»&lt;br&gt;&lt;b&gt;DESTINATIONS&lt;/b&gt;&lt;br&gt;Defined in server.py; served by /api/destinations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="670" width="340" height="110" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;connect() → sqlite3.Connection&lt;br&gt;init_db() creates tables and seeds demo data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="850" width="470" height="105" as="geometry"/></mxCell><mxCell id="inherit1" value="extends" style="endArrow=block;endFill=0;startArrow=none;html=1;strokeColor=#4a5568;" edge="1" parent="1" source="handler" target="base"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep1" value="request handler" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="server" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep2" value="HTTP JSON API · /api/*" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="app" target="handler"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep3" value="connect() / SQL" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep4" value="auth + ownership" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep5" value="create / revoke / lookup" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep6" value="list / create / update" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep7" value="list / update" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="countries"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep8" value="list by user" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="trips"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dep9" value="read-only API data" style="endArrow=open;startArrow=none;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="handler" target="destinations"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk1" value="1     0..*" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#4a5568;fontSize=11;" edge="1" parent="1" source="user" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk2" value="0..1     0..*" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#4a5568;fontSize=11;" edge="1" parent="1" source="user" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk3" value="0..1     0..*" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#4a5568;fontSize=11;" edge="1" parent="1" source="user" target="trips"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>